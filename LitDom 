<script>
document.addEventListener('DOMContentLoaded', async function () {

  /* =========================
     PAGE ELEMENTS
  ========================= */

  const signupArea =
    document.getElementById('litdom-signup');

  const loginArea =
    document.getElementById('litdom-login');

  const userArea =
    document.getElementById('litdom-user-area');

  const userEmail =
    document.getElementById('litdom-user-email');

  const logoutButton =
    document.getElementById('logout-button');

  const logoutMessage =
    document.getElementById('logout-message');


  /* =========================
     SIGN UP
  ========================= */

  const signupButton =
    document.getElementById('signup-button');

  const signupMessage =
    document.getElementById('signup-message');

  if (signupButton) {

    signupButton.addEventListener('click', async function () {

      const email =
        document.getElementById('signup-email').value.trim();

      const password =
        document.getElementById('signup-password').value;

      if (!email || !password) {
        signupMessage.textContent =
          'Please enter your email and password.';
        return;
      }

      signupMessage.textContent =
        'Creating your account...';

      const result =
        await litdomSupabase.auth.signUp({
          email: email,
          password: password,
          options: {
            emailRedirectTo:
              'https://litdom.blogspot.com/p/sign-up-for-litdom.html'
          }
        });

      if (result.error) {
        signupMessage.textContent =
          result.error.message;
        return;
      }

      signupMessage.textContent =
        'Account created! Please check your email to confirm your account.';

    });

  }


  /* =========================
     LOGIN
  ========================= */

  const loginButton =
    document.getElementById('login-button');

  const loginMessage =
    document.getElementById('login-message');

  if (loginButton) {

    loginButton.addEventListener('click', async function () {

      const email = document.getElementById('login-email').value.trim();
      const password = document.getElementById('login-password').value;

      if (!email || !password) {
        loginMessage.textContent = 'Please enter your email and password.';
        return;
      }

      loginMessage.textContent = 'Logging you in...';

      const result = await litdomSupabase.auth.signInWithPassword({
        email: email,
        password: password
      });

      if (result.error) {
        loginMessage.textContent = result.error.message;
        return;
      }

      const loggedInUser = result.data.user;

      loginMessage.textContent = 'Login successful! 🎉';

      window.location.href =
        'https://litdom.blogspot.com/p/profile.html#' +
        encodeURIComponent(loggedInUser.id);

    });

  }


  /* =========================
     CHECK CURRENT USER
  ========================= */

  const userResult =
    await litdomSupabase.auth.getUser();

  if (userResult.error) {
    console.log(
      'Could not get current user:',
      userResult.error.message
    );
    return;
  }

  const user =
    userResult.data.user;


  /* =====================================================
     LOGGED-IN USER
  ===================================================== */
  if (user) {

    if (userArea) {
      userArea.style.display = 'block';
    }

    if (signupArea) {
      signupArea.style.display = 'none';
    }

    if (loginArea) {
      loginArea.style.display = 'none';
    }

    if (userEmail) {
      userEmail.textContent =
        'Logged in as: ' + user.email;
    }


    /* =========================
       LOAD PROFILE
    ========================= */

    const profileResult =
      await litdomSupabase
        .from('profiles')
        .select('username, display_name, bio')
        .eq('id', user.id)
        .maybeSingle();

    if (profileResult.error) {

      console.log(
        'Profile loading error:',
        profileResult.error.message
      );

    } else if (profileResult.data) {

      const profile =
        profileResult.data;

      const displayNameElement =
        document.getElementById(
          'profile-display-name'
        );

      const usernameElement =
        document.getElementById(
          'profile-username'
        );

      if (displayNameElement) {
        displayNameElement.textContent =
          profile.display_name || 'Not set';
      }

      if (usernameElement) {
        usernameElement.textContent =
          profile.username || 'Not set';
      }

    }

    /* =========================
       SAVE PROFILE
    ========================= */

    const saveProfileButton =
      document.getElementById(
        'save-profile-button'
      );

    const profileSaveMessage =
      document.getElementById(
        'profile-save-message'
      );


    if (saveProfileButton) {

      saveProfileButton.addEventListener(
        'click',
        async function () {

          const displayName =
            document.getElementById(
              'edit-display-name'
            ).value.trim();

          const username =
            document.getElementById(
              'edit-username'
            ).value.trim();

          const bio =
            document.getElementById(
              'edit-bio'
            ).value.trim();


          profileSaveMessage.textContent =
            'Saving profile...';


          const updateResult =
            await litdomSupabase
              .from('profiles')
              .upsert({
                id: user.id,
                display_name: displayName,
                username: username,
                bio: bio
              })
              .select();


          /* =========================
             CHECK THE ACTUAL RESULT
          ========================= */

          if (updateResult.error) {

            profileSaveMessage.textContent =
              'Error: ' +
              updateResult.error.message;

            console.log(
              'Profile update error:',
              updateResult.error
            );

            return;
          }


          if (
            !updateResult.data ||
            updateResult.data.length === 0
          ) {

            profileSaveMessage.textContent =
              'Profile was not updated. No matching profile row was found.';

            console.log(
              'Profile update affected 0 rows.',
              'User ID:',
              user.id
            );

            return;
          }


          /* =========================
             SUCCESS
          ========================= */

          const displayNameElement =
            document.getElementById(
              'profile-display-name'
            );

          const usernameElement =
            document.getElementById(
              'profile-username'
            );

          if (displayNameElement) {
            displayNameElement.textContent =
              displayName || 'Not set';
          }

          if (usernameElement) {
            usernameElement.textContent =
              username || 'Not set';
          }


          profileSaveMessage.textContent =
            'Profile saved successfully! 🎉';

        }
      );

    }


    /* =========================
       LOG OUT
    ========================= */

    if (logoutButton) {

      logoutButton.addEventListener(
        'click',
        async function () {

          const result =
            await litdomSupabase.auth.signOut();

          if (result.error) {

            logoutMessage.textContent =
              result.error.message;

            return;
          }

          window.location.reload();

        }
      );

    }


  } else {

    /* =====================================================
       NO USER LOGGED IN
    ===================================================== */

    if (userArea) {
      userArea.style.display = 'none';
    }

    if (signupArea) {
      signupArea.style.display = 'block';
    }

    if (loginArea) {
      loginArea.style.display = 'block';
    }

  }

});
</script>




