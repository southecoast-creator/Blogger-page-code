Open a Blogger Boost 
<button class="blogger-boost-btn" onclick="openBoost()">
  🎁 Open a Blogger Boost
</button>

<div class="boost-overlay" id="boostOverlay">
  <div class="boost-box">
    <h3>🎉 Blogger Boost Unlocked!</h3>
    <p id="boostQuote"></p>
    <button class="close-boost" onclick="closeBoost()">Close</button>
  </div>
</div>

<script>
  const quotes = [
    "Someone needs the words you’re afraid to post.",
    "Write messy. Publish brave.",
    "Your blog doesn’t need perfection — it needs you.",
    "Every post is a brick. Keep building.",
    "You’re closer than your doubts want you to believe.",
    "Consistency beats talent when talent gets tired.",
    "This post might change someone’s day."
  ];

  function openBoost() {
    document.getElementById("boostOverlay").style.display = "flex";
    document.getElementById("boostQuote").innerText =
      quotes[Math.floor(Math.random() * quotes.length)];
    launchConfetti();
  }

  function closeBoost() {
    document.getElementById("boostOverlay").style.display = "none";
  }

  function launchConfetti() {
    for (let i = 0; i < 25; i++) {
      const confetti = document.createElement("div");
      confetti.className = "confetti";
      confetti.style.left = Math.random() * 100 + "vw";
      confetti.style.background =
        "hsl(" + Math.random() * 360 + ", 100%, 60%)";
      confetti.style.animationDuration = 2 + Math.random() * 2 + "s";
      document.body.appendChild(confetti);

      setTimeout(() => confetti.remove(), 4000);
    }
  }
</script>