async function loadBooks() {

booksContainer.innerHTML = "<div class="writer-dashboard-loading"> Loading your books... </div>";

const user = await getCurrentUser();

if (!user) {

booksContainer.innerHTML = `
  <div class="no-books-message">
    <p>Please log in to access your Writer Dashboard.</p>
  </div>
`;

return;

}

const {
data: books,
error
} = await litdomSupabase
.from('books')
.select("id, title, cover_url, description, genre, created_at, status")
.eq(
'author_id',
user.id
)
.order(
'created_at',
{
ascending: false
}
);

if (error) {

console.error(
  'Writer books loading error:',
  error
);

booksContainer.innerHTML = `
  <div class="no-books-message">
    <p>Unable to load your books.</p>
  </div>
`;

return;

}

if (!books || books.length === 0) {

booksContainer.innerHTML = `
  <div class="no-books-message">

    <p>
      You haven't created any books yet.
    </p>

    <p>
      Start your first story by clicking
      "Create New Book".
    </p>

  </div>
`;

return;

}

booksContainer.innerHTML = '';

books.forEach(function (book) {

const card =
  document.createElement('article');

card.className =
  'writer-book-card';


const cover =
  book.cover_url
    ? `
      <img
        src="${escapeHtml(book.cover_url)}"
        alt="${escapeHtml(
          book.title || 'Book cover'
        )}"
        class="writer-book-cover"
      >
    `
    : `
      <div class="
        writer-book-cover
        writer-book-cover-placeholder
      ">
        No Cover
      </div>
    `;


card.innerHTML = `

  ${cover}

  <div class="writer-book-content">

    <h3>
      ${escapeHtml(
        book.title || 'Untitled Book'
      )}
    </h3>

    ${
      book.genre
        ? `
          <p class="writer-book-genre">
            ${escapeHtml(book.genre)}
          </p>
        `
        : ''
    }

    <span class="writer-book-status">
      ${escapeHtml(
        book.status || 'draft'
      )}
    </span>

    <div class="writer-book-actions">

      <button
        type="button"
        class="edit-book-button"
        data-book-id="${escapeHtml(book.id)}">
        Edit
      </button>

      <button
        type="button"
        class="manage-chapters-button"
        data-book-id="${escapeHtml(book.id)}">
        Chapters
      </button>

    </div>

  </div>

`;


booksContainer.appendChild(card);

});

}

/* =====================================================
HTML ESCAPE
===================================================== */

function escapeHtml(value) {

if (
value === null ||
value === undefined
) {
return '';
}

return String(value)
.replace(/&/g, '&')
.replace(/</g, '<')
.replace(/>/g, '>')
.replace(/"/g, '"')
.replace(/'/g, ''');

}

