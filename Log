'.chapter-delete-button'
)
.forEach(
function (button) {

    button.addEventListener(
      'click',
      function () {

        deleteChapter(
          button.dataset.chapterId
        );

      }
    );

  }
);

}

/* =====================================================
GET NEXT CHAPTER NUMBER
===================================================== */

async function getNextChapterNumber() {

if (!activeBookId) {
return 1;
}

const {
data,
error
} =
await litdomSupabase
.from('chapters')
.select(
'chapter_number'
)
.eq(
'book_id',
activeBookId
)
.order(
'chapter_number',
{
ascending: false
}
)
.limit(1);

if (error) {

console.error(
  'Next chapter number error:',
  error
);

return 1;

}

if (
!data ||
data.length === 0
) {

return 1;

}

return (
Number(
data[0].chapter_number
) + 1
);

}

/* =====================================================
OPEN NEW CHAPTER
===================================================== */

newChapterButton.addEventListener(
'click',
async function () {

if (!activeBookId) {

  return;

}


activeChapterId =
  null;


chapterEditorHeading.textContent =
  'New Chapter';


chapterNumberInput.value =
  await getNextChapterNumber();


chapterTitleInput.value =
  '';

chapterContentInput.value =
  '';

chapterWordCount.textContent =
  '0 words';

chapterMessage.textContent =
  '';


chapterEditorModal.style.display =
  'block';


chapterTitleInput.focus();

}
);

/* =====================================================
OPEN EXISTING CHAPTER
===================================================== */

async function openChapterEditor(
chapterId
) {

if (!chapterId) {
return;
}

const {
data: chapter,
error
} =
await litdomSupabase
.from('chapters')
.select("id, book_id, chapter_number, title, content, status, word_count")
.eq(
'id',
chapterId
)
.eq(
'book_id',
activeBookId
)
.maybeSingle();

if (error) {

console.error(
  'Chapter editor loading error:',
  error
);

alert(
  'Unable to load chapter.'
);

return;

}

if (!chapter) {

alert(
  'Chapter not found.'
);

return;

}

activeChapterId =
chapter.id;

chapterEditorHeading.textContent =
'Edit Chapter';

chapterNumberInput.value =
chapter.chapter_number;

chapterTitleInput.value =
chapter.title ||
'';

chapterContentInput.value =
chapter.content ||
'';

updateChapterWordCount();

chapterMessage.textContent =
'';

chapterEditorModal.style.display =
'block';

chapterTitleInput.focus();

}

/* =====================================================
WORD COUNT
===================================================== */

function updateChapterWordCount() {

const content =
chapterContentInput.value.trim();

if (!content) {

chapterWordCount.textContent =
  '0 words';

return;

}

const count =
content
.split(/\s+/)
.filter(
function (word) {
return word.length > 0;
}
)
.length;

chapterWordCount.textContent =
"${count.toLocaleString()} words";

}

chapterContentInput.addEventListener(
'input',
updateChapterWordCount
);

/* =====================================================
SAVE CHAPTER
===================================================== */

chapterForm.addEventListener(
'submit',
async function (event) {

event.preventDefault();


if (!activeBookId) {

  chapterMessage.textContent =
    'No book selected.';

  return;
}


const user =
  await getCurrentUser();


if (!user) {

  chapterMessage.textContent =
    'Please log in first.';

  return;
}


const chapterNumber =
  Number(
    chapterNumberInput.value
  );


const title =
  chapterTitleInput.value.trim();


const content =
  chapterContentInput.value.trim();


/*
 * Since authors no longer control
 * publication locking, the only
 * chapter settings they control here
 * are number, title and content.
 *
 * Status remains available so the author
 * can save a draft or publish a chapter.
 */

const wordCount =
  content
    .split(/\s+/)
    .filter(
      function (word) {
        return word.length > 0;
      }
    )
    .length;


if (
  !chapterNumber ||
  chapterNumber < 1
) {

  chapterMessage.textContent =
    'Enter a valid chapter number.';

  return;
}


if (!title) {

  chapterMessage.textContent =
    'Please enter a chapter title.';

  return;
}


if (!content) {

  chapterMessage.textContent =
    'Please write your chapter content.';

  return;
}


saveChapterButton.disabled =
  true;


saveChapterButton.textContent =
  'Saving...';


chapterMessage.textContent =
  '';


try {

  /*
   * VERIFY BOOK OWNERSHIP
   */

  const {
    data: ownedBook,
    error: ownershipError
  } =
    await litdomSupabase
      .from('books')
      .select(
        'id'
      )
      .eq(
        'id',
        activeBookId
      )
      .eq(
        'author_id',
        user.id
      )
      .maybeSingle();


  if (ownershipError) {

    throw ownershipError;

  }


  if (!ownedBook) {

    throw new Error(
      'You do not have permission to edit this book.'
    );

  }


  /*
   * CHAPTER DATA
   *
   * IMPORTANT:
   * No Ruby.
   * No Diamonds.
   * No unlock cost.
   * No is_locked.
   */

  const chapterData = {

    book_id:
      activeBookId,

    chapter_number:
      chapterNumber,

    title:
      title,

    content:
      content,

    status:
      'draft',

    word_count:
      wordCount

  };


  /*
   * UPDATE EXISTING CHAPTER
   */

  if (activeChapterId) {

    const {
      error
    } =
      await litdomSupabase
        .from('chapters')
        .update({

          chapter_number:
            chapterData.chapter_number,

          title:
            chapterData.title,

          content:
            chapterData.content,

          word_count:
            chapterData.word_count,

          updated_at:
            new Date().toISOString()

        })
        .eq(
          'id',
          activeChapterId
        )
        .eq(
          'book_id',
          activeBookId
        );


    if (error) {
      throw error;
    }


    chapterMessage.textContent =
      'Chapter updated successfully! 🎉';

  }


  /*
   * CREATE NEW CHAPTER
   */

  else {

    const {
      error
    } =
      await litdomSupabase
        .from('chapters')
        .insert(
          chapterData
        );


    if (error) {
      throw error;
    }


    chapterMessage.textContent =
      'Chapter created successfully! 🎉';

  }


  await loadChapters();


  setTimeout(
    function () {

      chapterEditorModal.style.display =
        'none';

      chapterMessage.textContent =
        '';

      chapterForm.reset();

      activeChapterId =
        null;

    },
    700
  );


} catch (error) {

  console.error(
    'Chapter save error:',
    error
  );


  chapterMessage.textContent =
    error.message ||
    'Unable to save chapter.';

} finally {

  saveChapterButton.disabled =
    false;

  saveChapterButton.textContent =
    'Save Chapter';

}

}
);

/* =====================================================
DELETE CHAPTER
===================================================== */

async function deleteChapter(
chapterId
) {

if (!chapterId) {
return;
}

const confirmed =
window.confirm(
'Delete this chapter? This cannot be undone.'
);

if (!confirmed) {
return;
}

const user =
await getCurrentUser();

if (!user) {

alert(
  'Please log in first.'
);

return;

}

try {

/*
 * Verify book ownership first.
 */

const {
  data: ownedBook,
  error: ownershipError
} =
  await litdomSupabase
    .from('books')
    .select(
      'id'
    )
    .eq(
      'id',
      activeBookId
    )
    .eq(
      'author_id',
      user.id
    )
    .maybeSingle();


if (ownershipError) {
  throw ownershipError;
}


if (!ownedBook) {

  throw new Error(
    'You do not have permission to delete this chapter.'
  );

}


const {
  error
} =
  await litdomSupabase
    .from('chapters')
    .delete()
    .eq(
      'id',
      chapterId
    )
    .eq(
      'book_id',
      activeBookId
    );


if (error) {
  throw error;
}


await loadChapters();

} catch (error) {

console.error(
  'Chapter delete error:',
  error
);

alert(
  error.message ||
  'Unable to delete chapter.'
);

}

}

