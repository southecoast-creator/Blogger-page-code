/* =====================================================
OPEN CHAPTER MANAGER
===================================================== */

async function openChapterManager(
bookId,
bookTitle
) {

if (!bookId) {
return;
}

const user =
await getCurrentUser();

if (!user) {

alert(
  'Please log in first.'
);

return;

}

/*

* Verify that the current user owns
* this book before opening it.
  */

const {
data: book,
error
} =
await litdomSupabase
.from('books')
.select("id, title, author_id")
.eq(
'id',
bookId
)
.eq(
'author_id',
user.id
)
.maybeSingle();

if (error) {

console.error(
  'Book ownership error:',
  error
);

alert(
  'Unable to open this book.'
);

return;

}

if (!book) {

alert(
  'You do not have permission to manage this book.'
);

return;

}

activeBookId =
book.id;

activeChapterId =
null;

chapterManagerBookTitle.textContent =
book.title ||
bookTitle ||
'Book Chapters';

chapterEditorModal.style.display =
'none';

chapterModal.style.display =
'block';

await loadChapters();

}

