<script>
document.addEventListener('DOMContentLoaded', async function () {
  function formatCount(number) {
if (number < 1000) return number;

  if (number < 1000000) {
    return (number / 1000).toFixed(1).replace('.0', '') + 'K';
  }

  if (number < 1000000000) {
    return (number / 1000000).toFixed(1).replace('.0', '') + 'M';
  }

  return (number / 1000000000).toFixed(1).replace('.0', '') + 'B';
}

  /* =========================
     GET PROFILE ID
  ========================= */

  const params = new URLSearchParams(
  window.location.search
);

const urlProfileId = params.get('id');

const savedProfileId =
  localStorage.getItem('litdomProfileId');

const profileId =
  urlProfileId || savedProfileId;


  /* =========================
     BASIC ELEMENTS
========================= */

  const profileName =
    document.getElementById('public-profile-name');

  const profileUsername =
    document.getElementById('public-profile-username');

  const profileBio =
    document.getElementById('public-profile-bio');

  const authorName =
    document.getElementById('works-author-name');

  const avatarInitial =
    document.getElementById('public-profile-initial');
  /* =========================
   AVATAR ELEMENTS
========================= */

const avatarContainer =
  document.getElementById(
    'profile-avatar-container'
  );

const avatarImage =
  document.getElementById(
    'profile-avatar-image'
  );

const avatarInput =
  document.getElementById(
    'profile-avatar-input'

);
  
  /* =========================
   PROFILE AVATAR OWNERSHIP
========================= */

const avatarContainer =
  document.getElementById('profile-avatar-container');

const avatarInput =
  document.getElementById('profile-avatar-input');

const currentUserId =
  session && session.user
    ? session.user.id
    : null;

const isProfileOwner =
  currentUserId &&
  profileId &&
  currentUserId === profileId;
  /* =========================
   ONLY OWNER CAN EDIT AVATAR
========================= */

if (avatarContainer && avatarInput) {

  if (isProfileOwner) {

    avatarContainer.style.cursor = 'pointer';

    avatarContainer.addEventListener(
      'click',
      function () {
        avatarInput.click();

}
    );

  } else {

    /* Other users can see the picture,
       but cannot interact with it. */

    avatarContainer.style.cursor = 'default';

    avatarInput.style.display = 'none';

    avatarContainer.onclick = null;

  }
}
  
  /* =========================
   OPEN AVATAR PICKER
========================= */

if (avatarContainer && avatarInput) {

  avatarContainer.addEventListener(
    'click',
    function () {

      avatarInput.click();

    }
  );

}
  
/* =========================
   UPLOAD AVATAR
========================= */

if (avatarInput) {

  avatarInput.addEventListener(
    'change',
    async function () {

      const file = avatarInput.files[0];

      if (!file) {
        return;
      }

      /* Get logged-in user */

      const userResult =
        await litdomSupabase.auth.getUser();
      
            if (userResult.error || !userResult.data.user) {

        alert(
          'Please log in before changing your profile picture.'
        );

        avatarInput.value = '';
        return;
      }

      const user =
        userResult.data.user;

/* Check image type */

      if (!file.type.startsWith('image/')) {

        alert(
          'Please choose an image file.'
        );

        avatarInput.value = '';
        return;
      }
      
      
            /* Check image size */

      if (file.size > 5 * 1024 * 1024) {

        alert(
          'Please choose an image smaller than 5 MB.'
        );

        avatarInput.value = '';
        return;
      }


      /* Create a unique file name */

      const fileExtension =
        file.name.split('.').pop();

      const fileName =
        'profile-' +
        Date.now() +
        '.' +
fileExtension;

      const filePath =
        user.id +
        '/' +
        fileName;
      
            /* Upload image */

      const uploadResult =
        await litdomSupabase
          .storage
          .from('avatar')
          .upload(
            filePath,
            file
          );


      if (uploadResult.error) {

        console.error(
          'Avatar upload error:',
          uploadResult.error
        );

        alert(
          'Could not upload your profile picture: ' +
          uploadResult.error.message
        );

        avatarInput.value = '';
        return;
      }


      /* Get public image URL */

const publicUrlResult =
        litdomSupabase
          .storage
          .from('avatar')
          .getPublicUrl(filePath);

      const avatarUrl =
        publicUrlResult.data.publicUrl;
      
      
            /* Save URL to profile */

      const updateResult =
        await litdomSupabase
          .from('profiles')
          .update({
            avatar_url: avatarUrl
          })
          .eq('id', user.id);


      if (updateResult.error) {

        console.error(
          'Avatar profile update error:',
          updateResult.error
        );

        alert(
          'The picture uploaded, but the profile could not be updated: ' +
          updateResult.error.message
        );

        avatarInput.value = '';
        return;
      }
      
      
            /* Display picture immediately */

      if (avatarImage) {

        avatarImage.src =
          avatarUrl;

        avatarImage.style.display =
          'block';
      }

      if (avatarInitial) {

        avatarInitial.style.display =
          'none';
      }


      avatarInput.value = '';

      alert(
        'Profile picture updated! 🎉'
      );

    }
  );

}
      
  /* =========================
     NO PROFILE ID
  ========================= */

  if (!profileId) {

    if (profileName) {
      profileName.textContent = 'Profile not found';
    }

    if (profileUsername) {
      profileUsername.textContent = '';
    }

    if (profileBio) {
      profileBio.textContent =
        'No profile was specified.';
    }

    return;
  }
  
/* =========================
     LOAD PROFILE
  ========================= */

  const {
    data: profile,
    error: profileError
  } = await litdomSupabase
    .from('profiles')
    .select('id, username, display_name, bio')
    .eq('id', profileId)
    .maybeSingle();


  /* =========================
     PROFILE ERROR
  ========================= */

  if (profileError) {

    console.error(
      'Profile loading error:',
      profileError
    );

    if (profileName) {
      profileName.textContent =
        'Unable to load profile';
    }

    return;
  }

/* =========================
     PROFILE NOT FOUND
  ========================= */

  if (!profile) {

    if (profileName) {
      profileName.textContent =
