<style>
  .owner-profile-card {
    background: #2b1024;
    border: 1px solid #4a1f3d;
    border-radius: 16px;
    padding: 22px;
    max-width: 480px;
    margin: 20px auto;
    font-family: 'Fraunces', Georgia, serif;
  }

  .owner-profile-card h2 {
    color: #f4e6d8;
    font-size: 20px;
    margin: 0 0 18px;
    text-align: center;
    letter-spacing: 0.5px;
  }

  .owner-profile-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .owner-profile-actions button {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    background: #3a1730;
    border: 1px solid #55253f;
    border-radius: 12px;
    padding: 16px 8px;
    color: #d8c7d3;
    font-family: 'Fraunces', Georgia, serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.3px;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
  }

  .owner-profile-actions button:hover {
    background: #4a1f3d;
    border-color: #c9a24b;
    transform: translateY(-2px);
  }

  .owner-profile-actions button svg {
    width: 26px;
    height: 26px;
    stroke: #c9a24b;
    fill: none;
    stroke-width: 1.6;
  }
</style>

<div class="owner-profile-card">
  <h2>My Account</h2>

  <div class="owner-profile-actions">

    <button type="button" id="my-library-button">
      <svg viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      My Library
    </button>

    <button type="button" id="wallet-button">
      <svg viewBox="0 0 24 24"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4z"/></svg>
      Wallet
    </button>

    <button type="button" id="writers-dashboard-button">
      <svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
      Writers Dashboard
    </button>

    <button type="button" id="settings-button">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
      Settings
    </button>

  </div>
</div>