Navigation menu
<style>

/* ===== Mini Section Navigation ===== */

.mini-nav {

  background: #ffffff;

  padding: 12px 0;

  border-bottom: 1px solid #eee;

  position: sticky;

  top: 0;

  z-index: 999;

}

.mini-nav ul {

  list-style: none;

  margin: 0;

  padding: 0;

  text-align: center;

}

.mini-nav li {

  display: inline-block;

  margin: 0 15px;

}

.mini-nav a {

  text-decoration: none;

  font-size: 13px;

  font-weight: 500;

  color: #444;

  letter-spacing: 0.5px;

  transition: 0.3s ease;

  padding: 5px 0;

  position: relative;

}

/* Elegant Underline */

.mini-nav a::after {

  content: "";

  display: block;

  width: 0;

  height: 2px;

background: #7a5cff;

  transition: width 0.3s ease;

  margin-top: 4px;

}

.mini-nav a:hover {

  color: #7a5cff;

}

.mini-nav a:hover::after {

  width: 100%;

}

/* Mobile */

@media (max-width: 768px) {

  .mini-nav li {

    display: block;

    margin: 8px 0;

  }

}

</style>

<nav class="mini-nav">

  <ul>

    <li><a href="#services">Services</a></li>

    <li><a href="#portfolio">Portfolio</a></li>

    <li><a href="#testimonials">Testimonials</a></li>

    <li><a href="#delivery">Delivery</a></li>

    <li><a href="#payment">Payment</a></li>

    <li><a href="#milestones">Milestones</a></li>

    <li><a href="#confirmation">Confirmation</a></li>

  </ul>

</nav>

<script>

document.querySelectorAll('.mini-nav a').forEach(anchor => {

  anchor.addEventListener('click', function (e) {

    e.preventDefault();

    document.querySelector(this.getAttribute('href')).scrollIntoView({

      behavior: 'smooth'

    });

  });

});

</script>


 