<script>
window.addEventListener('load', () => {
  const sliders = document.querySelectorAll('.board-slider');
  sliders.forEach(slider => {
    let scrollAmount = 0;
    const board = slider.querySelector('.board');
    if (!board) return;
    const scrollStep = board.offsetWidth + 20; // board width + gap
    const scrollDelay = 3000;
    let intervalId;

    const startScroll = () => {
      intervalId = setInterval(() => {
        if (scrollAmount >= slider.scrollWidth - slider.clientWidth) {
          scrollAmount = 0;
        } else {
          scrollAmount += scrollStep;
        }
        slider.scrollTo({ left: scrollAmount, behavior: 'smooth' });
      }, scrollDelay);
    };

    const stopScroll = () => {
      clearInterval(intervalId);
    };

    startScroll();
    slider.addEventListener('mouseenter', stopScroll);
    slider.addEventListener('mouseleave', startScroll);
  });
});
</script>
