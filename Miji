<form id="create-book-form">

  <label for="book-title">
    Book title
  </label>

  <input
    id="book-title"
    type="text"
    placeholder="Enter your book title"
    required
  >

  <label for="book-description">
    Blurb
  </label>

  <textarea
    id="book-description"
    placeholder="Tell readers what your book is about"
  ></textarea>

  <label for="book-genre">
    Genre
  </label>

  <select id="book-genre">
    <option value="">
      Select a genre
    </option>
  </select>


  <!-- FICTION -->

  <div id="fiction-fields">

    <div class="type-field-group">

      <label for="age-rating">
        Age Rating
      </label>

      <select id="age-rating">
        <option value="">
          Select age rating
        </option>
        <option value="all-ages">
          All Ages
        </option>
        <option value="13+">
          13+
        </option>
        <option value="16+">
          16+
        </option>
        <option value="18+">
          18+
        </option>
      </select>

      <label for="fiction-tags">
        Tags
      </label>

      <input
        id="fiction-tags"
        type="text"
        placeholder="e.g. romance, billionaire, enemies-to-lovers"
      >

    </div>


    <div class="type-field-group">

      <label>
        Book Cover
      </label>

      <label
        for="fiction-book-cover"
        class="cover-upload-box"
      >

        <span class="cover-upload-icon">
          ＋
        </span>

        <strong>
          Upload Your Book Cover
        </strong>

        <span>
          600 × 800 px • Under 5 MB
        </span>

      </label>

      <input
        id="fiction-book-cover"
        type="file"
        accept="image/*"
        style="display:none;"
      >

      <p id="fiction-cover-message"></p>

    </div>

  </div>


  <!-- NON-FICTION -->

  <div id="nonfiction-fields">

    <label for="nonfiction-tags">
      Tags
    </label>

    <input
      id="nonfiction-tags"
      type="text"
      placeholder="e.g. confidence, mindset, personal growth"
    >

    <p>
      Add tags that describe your book. Separate each tag with a comma.
    </p>

    <div id="nonfiction-tag-chips"></div>


    <div class="type-field-group">

      <label for="nonfiction-subgenre">
        Subgenre / Niche
      </label>

      <select id="nonfiction-subgenre">
        <option value="">
          Select a niche
        </option>
      </select>

    </div>


    <div class="type-field-group">

      <label for="intended-audience">
        Intended Audience
      </label>

      <select id="intended-audience">

        <option value="">
          Select intended audience
        </option>

        <option value="13+">
          13+
        </option>

        <option value="16+">
          16+
        </option>

        <option value="18+">
          18+
        </option>

      </select>

    </div>


    <div class="type-field-group">

      <label for="nonfiction-content-level">
        Content Level
      </label>

      <select id="nonfiction-content-level">

        <option value="">
          Select content level
        </option>

        <option value="medium">
          Medium-content
        </option>

        <option value="high">
          High-content
        </option>

      </select>

    </div>


    <div class="type-field-group">

      <label>
        Book Cover
      </label>

      <label
        for="book-cover"
        class="cover-upload-box"
      >

        <span class="cover-upload-icon">
          ＋
        </span>

        <strong>
          Upload Your Book Cover
        </strong>

        <span>
          600 × 800 px • Under 5 MB
        </span>

      </label>

      <input
        id="book-cover"
        type="file"
        accept="image/*"
        style="display:none;"
      >

      <p id="cover-message"></p>

    </div>

  </div>


  <input
    id="selected-book-type"
    type="hidden"
  >

  <button
    id="save-book-button"
    type="submit"
  >
    Create Draft
  </button>

  <p id="create-book-message"></p>

</form>