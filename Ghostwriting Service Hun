<script>
const slider = document.getElementById('boardSlider');

let scrollAmount = 0;
const scrollStep = 191; // board width + gap
const scrollDelay = 3000;

setInterval(() => {
  if (!slider) return;

  if (scrollAmount >= slider.scrollWidth - slider.clientWidth) {
    scrollAmount = 0;
  } else {
    scrollAmount += scrollStep;
  }

  slider.scrollTo({
    left: scrollAmount,
    behavior: 'smooth'
  });
}, scrollDelay);
</script>
