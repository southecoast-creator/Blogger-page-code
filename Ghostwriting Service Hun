<script>
function openModal(button){
  const card = button.closest('.service-card');
  const total = card.querySelector('.total-price').textContent;
  const modal = document.getElementById('purchase-modal');
  modal.style.display = "block";
  modal.querySelector('p').textContent = `You have selected your package! Total: $${total}. Choose an option:`;
}
function closeModal(){
  document.getElementById('purchase-modal').style.display = "none";
}

// Auto-calculate total for each card
document.querySelectorAll('.service-card').forEach(card => {
  const quantityInput = card.querySelector('.package-quantity');
  const extras = card.querySelectorAll('.extra-option');
  const basePrice = parseInt(card.querySelector('.base-price').textContent);
  const totalPriceEl = card.querySelector('.total-price');

  function updateTotal(){
    let total = basePrice * parseInt(quantityInput.value);
    extras.forEach(extra => { if(extra.checked) total += parseInt(extra.dataset.price) * parseInt(quantityInput.value); });
    totalPriceEl.textContent = total;
  }

  quantityInput.addEventListener('input', updateTotal);
  extras.forEach(extra => extra.addEventListener('change', updateTotal));
  updateTotal();
});

// Close modal if clicked outside
window.onclick = function(event){
  const modal = document.getElementById('purchase-modal');
  if(event.target == modal){ modal.style.display = "none"; }
}
</script>
