.chapter-editor-box {
  width: min(900px, 94vw);
  max-height: 92vh;
  overflow-y: auto;
  padding: 30px;
}

.chapter-editor-box .dashboard-label {
  margin-bottom: 8px;
}

#chapter-editor-book-title {
  margin: 0 0 28px;
  font-size: 24px;
  line-height: 1.25;
}

.chapter-editor-number,
.chapter-editor-title,
.chapter-editor-content {
  margin-bottom: 22px;
}

.chapter-editor-number label,
.chapter-editor-title label,
.chapter-editor-content label {
  display: block;
  margin-bottom: 8px;
  font-size: 14px;
  font-weight: 600;
}

#chapter-number,
#chapter-title {
  width: 100%;
  box-sizing: border-box;
  padding: 13px 14px;
  border: 1px solid #ddd;
  border-radius: 10px;
  background: #fff;
  font-size: 15px;
  outline: none;
}

#chapter-number:focus,
#chapter-title:focus,
#chapter-content:focus {
  border-color: #b99a63;
  box-shadow: 0 0 0 3px rgba(185, 154, 99, 0.12);
}

#chapter-content {
  display: block;
  width: 100%;
  min-height: 520px;
  box-sizing: border-box;

  resize: vertical;

  padding: 20px;

  border: 1px solid #ddd;
  border-radius: 12px;

  background: #fff;

  font-family: inherit;
  font-size: 16px;
  line-height: 1.8;

  color: #222;

  outline: none;
}

.chapter-editor-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;

  padding-top: 8px;
}

#chapter-editor-word-count {
  font-weight: 600;
}

#chapter-editor-message {
  margin-top: 15px;
  font-size: 14px;
}

#save-chapter-draft {
  min-width: 130px;
}


/* =========================
   MOBILE CHAPTER EDITOR
========================= */

@media (max-width: 600px) {

  .chapter-editor-box {
    width: 100%;
    height: 100vh;
    max-height: 100vh;

    box-sizing: border-box;

    border-radius: 0;

    padding: 22px 16px;
  }

  #chapter-editor-book-title {
    font-size: 21px;
    margin-bottom: 22px;
  }

  #chapter-content {
    min-height: 55vh;

    padding: 16px;

    font-size: 16px;
    line-height: 1.75;
  }

  .chapter-editor-footer {
    align-items: stretch;
    flex-direction: column;
  }

  #save-chapter-draft {
    width: 100%;
  }

}












