async function loadChapters(bookId) {

  chaptersList.innerHTML =
    "<p>Loading chapters...</p>";

  chapterCount.textContent =
    "0";

  chapterWordCount.textContent =
    "0";


  const {
    data: chapters,
    error
  } = await supabaseClient
    .from("chapters")
    .select(
      "id,book_id,chapter_number,title,status,word_count,is_locked,created_at,updated_at,published_at,submitted_at"
    )
    .eq(
      "book_id",
      bookId
    )
    .order(
      "chapter_number",
      {
        ascending: true
      }
    );


  if (error) {

    console.error(error);

    chaptersList.innerHTML =
      "<p>Unable to load chapters.</p>";

    return;
  }


  chapterCount.textContent =
    chapters.length;


  const totalWords =
    chapters.reduce(
      function (total, chapter) {

        return total +
          (
            Number(
              chapter.word_count
            ) || 0
          );

      },
      0
    );


  chapterWordCount.textContent =
    totalWords.toLocaleString();


  if (!chapters.length) {

    chaptersList.innerHTML =
      '<p class="empty-chapters">No chapters yet.</p>';

    return;
  }


  chaptersList.innerHTML =
    "";


  chapters.forEach(
    function (chapter) {

      const chapterCard =
        document.createElement(
          "div"
        );

      chapterCard.className =
        "chapter-card";


      const chapterTitle =
        document.createElement(
          "h3"
        );

      chapterTitle.textContent =
        "Chapter " +
        (
          chapter.chapter_number ||
          "—"
        ) +
        (
          chapter.title
            ? " — " +
              chapter.title
            : ""
        );


      const chapterMeta =
        document.createElement(
          "div"
        );

      chapterMeta.className =
        "chapter-meta";

      chapterMeta.textContent =
        (
          Number(
            chapter.word_count
          ) || 0
        ).toLocaleString() +
        " words • " +
        (
          chapter.status ||
          "draft"
        );


      chapterCard.appendChild(
        chapterTitle
      );

      chapterCard.appendChild(
        chapterMeta
      );

      chaptersList.appendChild(
        chapterCard
      );

    }
  );

}








