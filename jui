<script>
document.addEventListener('DOMContentLoaded', async function () {

  /* =========================
     GET PROFILE ID
  ========================= */

  const params =
    new URLSearchParams(window.location.search);

  const urlProfileId =
    params.get('id');

  const savedProfileId =
    localStorage.getItem('litdomProfileId');

  const profileId =
    urlProfileId || savedProfileId;


  if (!profileId) {
    return;
  }


  /* =========================
     CREATE / GET LIST AREAS
========================= */

  let followersList =
    document.getElementById('followers-list');

  let followingList =
    document.getElementById('following-list');


  if (!followersList) {

    followersList =
      document.createElement('div');

    followersList.id =
      'followers-list';

    followersList.style.display =
      'none';

    const followArea =
      document.getElementById(
        'profile-follow-area'
      );

    if (followArea) {
      followArea.appendChild(
        followersList
      );
    }
  }

if (!followingList) {

    followingList =
      document.createElement('div');

    followingList.id =
      'following-list';

    followingList.style.display =
      'none';

    const followArea =
      document.getElementById(
        'profile-follow-area'
      );

    if (followArea) {
      followArea.appendChild(
        followingList
      );
    }
  }


  /* =========================
     GET BUTTONS
  ========================= */

  const followersButton =
    document.getElementById(
      'followers-button'
    );

  const followingButton =
    document.getElementById(
      'following-button'
    );


  if (
    !followersButton ||
    !followingButton ||
    !followersList ||
    !followingList
  ) {
    return;
  }


  /* =========================
LOAD USERS
  ========================= */

  async function loadUsers(
    type,
    container
  ) {

    container.innerHTML =
      '<p>Loading...</p>';


    const column =
      type === 'followers'
        ? 'following_id'
        : 'follower_id';


    const userColumn =
      type === 'followers'
        ? 'follower_id'
        : 'following_id';


    /* =========================
       GET FOLLOW RELATIONSHIPS
    ========================= */

    const {
      data: follows,
      error
    } = await litdomSupabase
      .from('follows')
      .select(userColumn)
      .eq(
        column,
        profileId
      );
if (error) {

      console.error(
        'Follow list error:',
        error
      );

      container.innerHTML =
        '<p>Unable to load list.</p>';

      return;
    }


    if (
      !follows ||
      follows.length === 0
    ) {

      container.innerHTML =
        type === 'followers'
          ? '<p>No followers yet.</p>'
          : '<p>Not following anyone yet.</p>';

      return;
    }


    /* =========================
       GET USER IDS
    ========================= */

    const userIds =
      follows.map(
        function (row) {
          return row[userColumn];
        }
      );


    /* =========================
       GET PROFILES
    ========================= */
const {
      data: profiles,
      error: profileError
    } = await litdomSupabase
      .from('profiles')
      .select(
        'id, username, display_name'
      )
      .in(
        'id',
        userIds
      );


    if (profileError) {

      console.error(
        'Profile list error:',
        profileError
      );

      container.innerHTML =
        '<p>Unable to load profiles.</p>';

      return;
    }


    if (
      !profiles ||
      profiles.length === 0
    ) {

      container.innerHTML =
        '<p>Profiles could not be found.</p>';

      return;

}


    /* =========================
       DISPLAY USERS
    ========================= */

    container.innerHTML = '';


    profiles.forEach(
      function (profile) {

        const name =
          profile.display_name ||
          profile.username ||
          'Litdom User';


        const username =
          profile.username
            ? '@' + profile.username
            : '';


        const item =
          document.createElement('div');

        item.className =
          'litdom-follow-user';


        item.innerHTML = `
          <a href="/p/profile.html?id=${encodeURIComponent(profile.id)}">
            <strong>${name}</strong>
            <span>${username}</span>

</a>
        `;


        container.appendChild(
          item
        );

      }
    );

  }


  /* =========================
     FOLLOWERS BUTTON
  ========================= */

 
      if (isOpen) {

        followersList.style.display =
          'none';

        return;
      }


      followersList.style.display =
        'block';


      await loadUsers(
        'followers',
        followersList
      );
}
  );


  /* =========================
     FOLLOWING BUTTON
  ========================= */

  followingButton.addEventListener(
    'click',
    async function () {

      const isOpen =
        followingList.style.display !== 'none';


      followersList.style.display =
        'none';


      if (isOpen) {

        followingList.style.display =
          'none';

        return;
      }


      followingList.style.display =
        'block';


      await loadUsers(
        'following',
        followingList
  );

    }
  );

});
</script>







/* =========================
   LOAD AUTHOR'S PUBLISHED WORKS
========================= */

const authorBooks =
  document.getElementById('author-books');

if (authorBooks) {

  authorBooks.innerHTML = `
    <p class="profile-loading">
      Loading works...
    </p>
  `;

  const {
    data: books,
    error: booksError
  } = await litdomSupabase
    .from('books')
    .select(`
      id,
      title,
      cover_url,
      description,
      genre,
      created_at,
      status
    `)
    .eq('author_id', profileId)
    .eq('status', 'published')
    .order('created_at', {
      ascending: false
    });

  if (booksError) {

    console.error(
      'Author books loading error:',
      booksError
    );

    authorBooks.innerHTML = `
      <p class="profile-loading">
        Unable to load works.
      </p>
    `;

  } else if (!books || books.length === 0) {

    authorBooks.innerHTML = `
      <p class="profile-loading">
        No published works yet.
      </p>
    `;

  } else {

    authorBooks.innerHTML = '';

    books.forEach(function (book) {

      const card =
        document.createElement('article');

      card.className =
        'profile-book-card';

      const cover =
        book.cover_url
          ? `
            <img
              src="${book.cover_url}"
              alt="${book.title || 'Book cover'}"
              class="profile-book-cover"
            >
          `
          : `
            <div class="profile-book-cover profile-book-cover-placeholder">
              No Cover
            </div>
          `;

      card.innerHTML = `
        ${cover}

        <div class="profile-book-info">

          <h3>
            ${book.title || 'Untitled Book'}
          </h3>

          ${
            book.genre
              ? `<p class="profile-book-genre">${book.genre}</p>`
              : ''
          }

          ${
            book.description
              ? `<p class="profile-book-description">
                  ${book.description}
                </p>`
              : ''
          }

        </div>
      `;

      authorBooks.appendChild(card);

    });

  }

}