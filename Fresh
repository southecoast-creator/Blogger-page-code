<script>
document.addEventListener('DOMContentLoaded', async function () {

  /* =====================================================
     ELEMENTS
  ===================================================== */

  const profileName =
    document.getElementById('public-profile-name');

  const profileUsername =
    document.getElementById('public-profile-username');

  const profileBio =
    document.getElementById('public-profile-bio');

  const authorName =
    document.getElementById('works-author-name');

  const avatarInitial =
    document.getElementById('public-profile-initial');

  const avatarContainer =
    document.getElementById('profile-avatar-container');

  const avatarImage =
    document.getElementById('profile-avatar-image');

  const avatarInput =
    document.getElementById('profile-avatar-input');

  const ownerArea =
    document.getElementById('profile-owner-area');

  const loginGate =
    document.getElementById('profile-login-gate');

  const profileContent =
    document.getElementById('profile-content');


  /* =====================================================
     CACHE CONFIG
  ===================================================== */

  const PROFILE_CACHE_PREFIX = 'litdomProfileCache_';
  const PROFILE_CACHE_TTL_MS = 5 * 60 * 1000; // 5 minutes

  function getCachedProfile(id) {
    try {
      const raw = localStorage.getItem(PROFILE_CACHE_PREFIX + id);
      if (!raw) return null;

      const parsed = JSON.parse(raw);

      if (Date.now() - parsed.cachedAt > PROFILE_CACHE_TTL_MS) {
        localStorage.removeItem(PROFILE_CACHE_PREFIX + id);
        return null;
      }

      return parsed.data;
    } catch (e) {
      return null;
    }
  }

  function setCachedProfile(id, data) {
    try {
      localStorage.setItem(
        PROFILE_CACHE_PREFIX + id,
        JSON.stringify({ cachedAt: Date.now(), data: data })
      );
    } catch (e) {
      // storage full or unavailable - fail silently, not critical
    }
  }


  /* =====================================================
     HELPERS
  ===================================================== */

  function formatCount(number) {

    if (number < 1000) {
      return number;
    }

    if (number < 1000000) {
      return (
        number / 1000
      ).toFixed(1).replace('.0', '') + 'K';
    }

    if (number < 1000000000) {
      return (
        number / 1000000
      ).toFixed(1).replace('.0', '') + 'M';
    }

    return (
      number / 1000000000
    ).toFixed(1).replace('.0', '') + 'B';
  }


  /* =====================================================
     GET PROFILE ID FROM URL (if viewing someone else)
  ===================================================== */

  const params =
    new URLSearchParams(
      window.location.search
    );

  const urlProfileId =
    params.get('id');


  /* =====================================================
     CHECK LOGIN
  ===================================================== */

  const {
    data: { session },
    error: sessionError
  } =
    await litdomSupabase.auth.getSession();


  if (sessionError) {

    console.error(
      'Session check error:',
      sessionError
    );

    if (loginGate) {
      loginGate.style.display = 'block';
    }

    if (profileContent) {
      profileContent.style.display = 'none';
    }

    return;
  }


  /* =====================================================
     LOGIN GATE
  ===================================================== */

  if (!session || !session.user) {

    if (loginGate) {
      loginGate.style.display = 'block';
    }

    if (profileContent) {
      profileContent.style.display = 'none';
    }

    return;
  }


  /* =====================================================
     LOGGED-IN USER
  ===================================================== */

  if (loginGate) {
    loginGate.style.display = 'none';
  }

  if (profileContent) {
    profileContent.style.display = 'block';
  }


  const currentUser = session.user;


  /* =====================================================
     RESOLVE PROFILE ID
     - URL id present -> viewing someone else's profile
     - otherwise -> viewing our own profile
  ===================================================== */

  const profileId =
    urlProfileId ||
    currentUser.id;


  if (!profileId) {

    if (profileName) {
      profileName.textContent = 'Profile not found';
    }

    if (profileUsername) {
      profileUsername.textContent = '';
    }

    if (profileBio) {
      profileBio.textContent = 'No profile was specified.';
    }

    return;
  }


  /* =====================================================
     LOAD PROFILE (cache-first)
  ===================================================== */

  let profile = getCachedProfile(profileId);

  if (!profile) {

    const {
      data: fetchedProfile,
      error: profileError
    } =
      await litdomSupabase
        .from('profiles')
        .select(
          'id, username, display_name, bio, avatar_url'
        )
        .eq('id', profileId)
        .maybeSingle();


    if (profileError) {

      console.error(
        'Profile loading error:',
        profileError
      );

      if (profileName) {
        profileName.textContent = 'Unable to load profile';
      }

      return;
    }

    profile = fetchedProfile;

    if (profile) {
      setCachedProfile(profileId, profile);
    }
  }


  /* =====================================================
     PROFILE NOT FOUND
  ===================================================== */

  if (!profile) {

    if (profileName) {
      profileName.textContent = 'Profile not found';
    }

    if (profileUsername) {
      profileUsername.textContent = '';
    }

    if (profileBio) {
      profileBio.textContent = 'This profile does not exist.';
    }

    return;
  }


  /* =====================================================
     OWNER CHECK
  ===================================================== */

  const isProfileOwner =
    currentUser.id === profile.id;


  if (ownerArea) {

    ownerArea.style.display =
      isProfileOwner ? 'block' : 'none';
  }


  /* =====================================================
     PROFILE INFORMATION
  ===================================================== */

  const displayName =
    profile.display_name ||
    profile.username ||
    'Litdom User';

  const username =
    profile.username ||
    'username';

  const bio =
    profile.bio ||
    'No bio yet.';


  if (profileName) {
    profileName.textContent = displayName;
  }

  if (profileUsername) {
    profileUsername.textContent = '@' + username;
  }

  if (profileBio) {
    profileBio.textContent = bio;
  }

  if (authorName) {
    authorName.textContent = displayName;
  }


  /* =====================================================
     LOAD AUTHOR'S PUBLISHED WORKS (cache-first)
  ===================================================== */

  const authorBooks =
    document.getElementById('profile-books');

  if (authorBooks) {

    const BOOKS_CACHE_KEY =
      'litdomAuthorBooksCache_' + profileId;

    let books = null;

    try {
      const rawBooks = localStorage.getItem(BOOKS_CACHE_KEY);
      if (rawBooks) {
        const parsedBooks = JSON.parse(rawBooks);
        if (Date.now() - parsedBooks.cachedAt <= PROFILE_CACHE_TTL_MS) {
          books = parsedBooks.data;
        } else {
          localStorage.removeItem(BOOKS_CACHE_KEY);
        }
      }
    } catch (e) {
      books = null;
    }

    if (!books) {

      authorBooks.innerHTML = `
        <p class="profile-loading">
          Loading works...
        </p>
      `;

      const {
        data: fetchedBooks,
        error: booksError
      } = await litdomSupabase
        .from('books')
        .select(`
          id,
          title,
          cover_url,
          description,
          genre,
          created_at,
          status
        `)
        .eq('author_id', profileId)
        .eq('status', 'published')
        .order('created_at', { ascending: false });

      if (booksError) {

        console.error(
          'Author books loading error:',
          booksError
        );

        authorBooks.innerHTML = `
          <p class="profile-loading">
            Unable to load works.
          </p>
        `;

        books = null;

      } else {

        books = fetchedBooks || [];

        try {
          localStorage.setItem(
            BOOKS_CACHE_KEY,
            JSON.stringify({ cachedAt: Date.now(), data: books })
          );
        } catch (e) {
          // ignore storage errors
        }
      }
    }

    if (books) {

      if (books.length === 0) {

        authorBooks.innerHTML = `
          <p class="profile-loading">
            No published works yet.
          </p>
        `;

      } else {

        authorBooks.innerHTML = '';

        books.forEach(function (book) {

          const card =
            document.createElement('a');

          card.className =
            'profile-book-card';

          card.href =
            '/p/books.html?book=' +
            encodeURIComponent(book.id);

          card.style.textDecoration = 'none';

          const cover =
            book.cover_url
              ? `
                <img
                  src="${book.cover_url}"
                  alt="${book.title || 'Book cover'}"
                  class="profile-book-cover"
                >
              `
              : `
                <div class="profile-book-cover profile-book-cover-placeholder">
                  No Cover
                </div>
              `;

          card.innerHTML = `
            ${cover}

            <div class="profile-book-info">

              <h3>
                ${book.title || 'Untitled Book'}
              </h3>

              ${
                book.genre
                  ? `<p class="profile-book-genre">${book.genre}</p>`
                  : ''
              }

              ${
                book.description
                  ? `<p class="profile-book-description">
                      ${book.description}
                    </p>`
                  : ''
              }

            </div>
          `;

          authorBooks.appendChild(card);

        });
      }
    }
  }


  /* =====================================================
     PROFILE INITIAL
  ===================================================== */

  if (avatarInitial) {

    avatarInitial.textContent =
      displayName.charAt(0).toUpperCase();
  }


  /* =====================================================
     LOAD PROFILE AVATAR
  ===================================================== */

  if (profile.avatar_url && avatarImage) {

    avatarImage.src = profile.avatar_url;
    avatarImage.style.display = 'block';

    if (avatarInitial) {
      avatarInitial.style.display = 'none';
    }
  }


  /* =====================================================
     AVATAR OWNERSHIP
  ===================================================== */

  if (avatarContainer && avatarInput) {

    if (isProfileOwner) {

      avatarContainer.style.cursor = 'pointer';

      avatarContainer.onclick = function () {
        avatarInput.click();
      };

    } else {

      avatarContainer.style.cursor = 'default';
      avatarInput.style.display = 'none';
      avatarContainer.onclick = null;
    }
  }


  /* =====================================================
     AVATAR UPLOAD
  ===================================================== */

  if (avatarInput && isProfileOwner) {

    avatarInput.addEventListener('change', async function () {

      const file = avatarInput.files[0];

      if (!file) {
        return;
      }

      if (!file.type.startsWith('image/')) {
        alert('Please choose an image file.');
        avatarInput.value = '';
        return;
      }

      if (file.size > 5 * 1024 * 1024) {
        alert('Please choose an image smaller than 5 MB.');
        avatarInput.value = '';
        return;
      }

      const fileExtension =
        file.name.split('.').pop();

      const fileName =
        'profile-' + Date.now() + '.' + fileExtension;

      const filePath =
        currentUser.id + '/' + fileName;

      const uploadResult =
        await litdomSupabase
          .storage
          .from('avatar')
          .upload(filePath, file);

      if (uploadResult.error) {

        console.error(
          'Avatar upload error:',
          uploadResult.error
        );

        alert(
          'Could not upload your profile picture: ' +
          uploadResult.error.message
        );

        avatarInput.value = '';
        return;
      }

      const publicUrlResult =
        litdomSupabase
          .storage
          .from('avatar')
          .getPublicUrl(filePath);

      const avatarUrl =
        publicUrlResult.data.publicUrl;

      const updateResult =
        await litdomSupabase
          .from('profiles')
          .update({ avatar_url: avatarUrl })
          .eq('id', currentUser.id);

      if (updateResult.error) {

        console.error(
          'Avatar profile update error:',
          updateResult.error
        );

        alert(
          'The picture uploaded, but the profile could not be updated: ' +
          updateResult.error.message
        );

        avatarInput.value = '';
        return;
      }

      /* invalidate cache since profile changed */
      localStorage.removeItem(PROFILE_CACHE_PREFIX + currentUser.id);

      if (avatarImage) {
        avatarImage.src = avatarUrl;
        avatarImage.style.display = 'block';
      }

      if (avatarInitial) {
        avatarInitial.style.display = 'none';
      }

      avatarInput.value = '';

      alert('Profile picture updated! 🎉');
    });
  }


  /* =====================================================
     FOLLOW AREA
  ===================================================== */

  let followArea =
    document.getElementById('profile-follow-area');

  if (!followArea) {

    followArea = document.createElement('div');
    followArea.id = 'profile-follow-area';

    followArea.innerHTML = `
      <div id="profile-stats">
        <span>
          <strong id="follower-count">0</strong>
          Followers
        </span>
        <span>
          <strong id="following-count">0</strong>
          Following
        </span>
      </div>

      <button id="follow-button" type="button">
        Follow
      </button>

      <p id="follow-message"></p>
    `;

    if (profileBio) {
      profileBio.parentNode.appendChild(followArea);
    }
  }


  /* =====================================================
     FOLLOW ELEMENTS
  ===================================================== */

  const followButton =
    document.getElementById('follow-button');

  const followerCount =
    document.getElementById('follower-count');

  const followingCount =
    document.getElementById('following-count');

  const followMessage =
    document.getElementById('follow-message');


  /* =====================================================
     FOLLOW COUNTS
  ===================================================== */

  if (followerCount && followingCount) {

    const {
      count: followers,
      error: followerError
    } =
      await litdomSupabase
        .from('follows')
        .select('*', { count: 'exact', head: true })
        .eq('following_id', profileId);

    if (followerError) {
      console.error('Follower count error:', followerError);
    } else {
      followerCount.textContent = formatCount(followers || 0);
    }

    const {
      count: following,
      error: followingError
    } =
      await litdomSupabase
        .from('follows')
        .select('*', { count: 'exact', head: true })
        .eq('follower_id', profileId);

    if (followingError) {
      console.error('Following count error:', followingError);
    } else {
      followingCount.textContent = formatCount(following || 0);
    }
  }


  /* =====================================================
     FOLLOW BUTTON
  ===================================================== */

  if (!followButton || isProfileOwner) {

    if (followButton && isProfileOwner) {
      followButton.style.display = 'none';
    }

  } else {

    let existingFollow = null;

    const {
      data: followData,
      error: followCheckError
    } =
      await litdomSupabase
        .from('follows')
        .select('id')
        .eq('follower_id', currentUser.id)
        .eq('following_id', profileId)
        .maybeSingle();

    if (followCheckError) {
      console.error('Follow check error:', followCheckError);
    } else {
      existingFollow = followData;
    }

    followButton.textContent =
      existingFollow ? 'Following' : 'Follow';

    followButton.addEventListener('click', async function () {

      followButton.disabled = true;

      if (existingFollow) {

        const { error } =
          await litdomSupabase
            .from('follows')
            .delete()
            .eq('id', existingFollow.id);

        if (error) {
          console.error('Unfollow error:', error);
          followButton.disabled = false;
          return;
        }

        existingFollow = null;
        followButton.textContent = 'Follow';

      } else {

        const { data: newFollow, error } =
          await litdomSupabase
            .from('follows')
            .insert({
              follower_id: currentUser.id,
              following_id: profileId
            })
            .select('id')
            .single();

        if (error) {
          console.error('Follow error:', error);
          if (followMessage) {
            followMessage.textContent = error.message;
          }
          followButton.disabled = false;
          return;
        }

        existingFollow = newFollow;
        followButton.textContent = 'Following';

        if (followMessage) {
          followMessage.textContent = 'Following this user.';
        }
      }

      followButton.disabled = false;
    });
  }

});
</script>